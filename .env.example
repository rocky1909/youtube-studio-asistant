# Browser TTS and mock generation work without any keys.

# Core live text generation
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Live image generation
HUGGINGFACE_API_KEY=
HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Live voice generation
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Live media and video generation
REPLICATE_API_TOKEN=
REPLICATE_MODEL=
REPLICATE_IMAGE_MODEL=
REPLICATE_VIDEO_MODEL=

# Team mode with Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional public aliases for client auth mode
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional custom table names
TEAM_PROJECTS_TABLE=team_projects
TEAM_SNAPSHOTS_TABLE=team_project_snapshots
TEAM_HISTORY_TABLE=team_project_history
